<?xml version="1.0" encoding="utf-8"?>
<!--
    Google TV's launcher banner: 320 x 180 dp, drawn at the required 16:9 so the launcher never
    letterboxes it. The mark is the unchanged production vector on the app's own charcoal, scaled
    and placed by group transform rather than redrawn — a banner is not a new logo.

    VectorRaster is suppressed on purpose: lint asks for vectors under 200x200 because most are
    icons, but a launcher banner has to be exactly 320x180 dp. It is drawn once, by the launcher,
    from a handful of paths — the cost lint is guarding against does not apply here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="VectorRaster"
    android:width="320dp" android:height="180dp"
    android:viewportWidth="320" android:viewportHeight="180">

    <path android:fillColor="#101211" android:pathData="M0,0 H320 V180 H0 Z" />

    <group android:translateX="34" android:translateY="43" android:scaleX="2.1" android:scaleY="2.1">
        <path android:fillColor="#D5F675" android:fillType="evenOdd"
            android:pathData="M29,4 C25,1 21,0 16,0 C7,0 1,4 1,10 C1,16 6,18 14,20 C20,21 23,22 23,24 C23,26 20,27 16,27 C11,27 7,25 3,22 L0,28 C4,31 10,33 16,33 C25,33 31,29 31,23 C31,17 26,14 18,12 C11,11 8,10 8,8 C8,6 11,6 15,6 C19,6 23,7 26,9 Z" />
    </group>

    <!-- Wordmark, drawn as paths so the banner needs no font at launcher-render time. -->
    <group android:translateX="118" android:translateY="76">
        <path android:fillColor="#F3F3EC"
            android:pathData="M29,4 C25,1 21,0 16,0 C7,0 1,4 1,10 C1,16 6,18 14,20 C20,21 23,22 23,24 C23,26 20,27 16,27 C11,27 7,25 3,22 L0,28 C4,31 10,33 16,33 C25,33 31,29 31,23 C31,17 26,14 18,12 C11,11 8,10 8,8 C8,6 11,6 15,6 C19,6 23,7 26,9 Z" />
        <path android:fillColor="#F3F3EC"
            android:pathData="M38,7 H58 Q66,7 66,15 V23 Q66,31 58,31 H45 V40 H38 Z M45,14 V24 H56 Q59,24 59,21 V17 Q59,14 56,14 Z" />
        <path android:fillColor="#F3F3EC"
            android:pathData="M74,15 Q74,7 82,7 H94 Q102,7 102,15 V23 Q102,31 94,31 H82 Q74,31 74,23 Z M81,17 V21 Q81,24 84,24 H92 Q95,24 95,21 V17 Q95,14 92,14 H84 Q81,14 81,17 Z" />
        <path android:fillColor="#F3F3EC" android:pathData="M110,0 H117 V31 H110 Z" />
        <path android:fillColor="#F3F3EC"
            android:pathData="M125,15 Q125,7 133,7 H145 Q153,7 153,15 V21 H132 Q132,24 135,24 H152 Q152,31 145,31 H133 Q125,31 125,23 Z M132,16 H146 Q146,14 143,14 H135 Q132,14 132,16 Z" />
    </group>
</vector>
