<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Reelstack" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/reelstack_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/reelstack_background</item>
        <item name="android:windowSplashScreenBackground">@color/reelstack_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/spole_splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/reelstack_background</item>
    </style>
</resources>
